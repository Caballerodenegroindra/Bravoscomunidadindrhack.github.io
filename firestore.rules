// ═══════════════════════════════════════════════════════════
// REGLAS COMPLETAS DE FIRESTORE — Academia Indrhack
// ═══════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────
    // FUNCIONES AUXILIARES
    // ───────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().rol == 'administrador';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function canAccessRoom(roomId) {
      let roomPath = /databases/$(database)/documents/chat_rooms/$(roomId);
      return !exists(roomPath) ||
        get(roomPath).data.type != 'dm' ||
        request.auth.uid in get(roomPath).data.participants;
    }

    // ───────────────────────────────────────────────────────
    // NOMBRES DE USUARIO (para validar unicidad y resolver el
    // login sin exponer perfiles completos con teléfono, etc.)
    // NOTA: este documento SÍ guarda el email (necesario para que
    // el login por username funcione sin backend propio), por lo
    // tanto el email queda públicamente consultable por username.
    // El teléfono y el resto del perfil NO están acá.
    // ───────────────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      // "create" solo dispara si el documento (username) no existe
      // todavía, así Firestore ya impide duplicados de forma nativa.
      // El admin puede crear/corregir en nombre de otros (necesario
      // para la migración única de cuentas creadas antes de este
      // sistema, y para arreglos manuales de soporte).
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.uid == request.auth.uid
          && username.matches('^[a-z0-9]{3,20}$'));
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // USUARIOS
    // ───────────────────────────────────────────────────────
    match /users/{userId} {
      // Antes: "allow read: if true" exponía email y teléfono de TODOS
      // los usuarios a cualquiera en internet, sin necesidad de sesión.
      // Como el registro está abierto, "isSignedIn()" solo no basta:
      // cualquiera podría crear una cuenta y leer igual todo antes de
      // ser aprobado. Por eso se exige además estado == 'aprobado',
      // salvo para leer el propio perfil (necesario para ver tu estado
      // "pendiente" tras registrarte) o para el admin.
      allow read: if isOwner(userId) || isAdmin() ||
        (isSignedIn() && myProfile().estado == 'aprobado');

      allow create: if isOwner(userId)
        && request.resource.data.rol == 'usuario'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.username.matches('^[a-z0-9]{3,20}$');

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.rol    == resource.data.rol &&
        request.resource.data.estado == resource.data.estado
      );

      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // CURSOS (catálogo público)
    // ───────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // NOTIFICACIONES
    // ───────────────────────────────────────────────────────
    // La mayoría (cuenta, proyecto, curso nuevo) las crea
    // solo el admin. Excepción: "respuesta_hilo",
    // que puede crearla cualquier usuario logueado porque se
    // dispara cuando OTRO usuario (no el admin) responde un
    // mensaje en un hilo del chat. Se exige además que la
    // notificación sea para otra persona, nunca para uno mismo.
    match /notificaciones/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.tipo == 'respuesta_hilo' &&
        request.resource.data.uid != request.auth.uid
      );
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ───────────────────────────────────────────────────────
    // CLASES DE TERMUX
    // ───────────────────────────────────────────────────────
    match /clases_termux/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /cursos_aprobados/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /proyectos_base/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /proyectos/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // VOLUNTARIOS DEL PROYECTO (equipo de desarrollo de la app)
    // Cualquier usuario aprobado puede pedir sumarse al equipo que
    // desarrolla la app. El admin revisa y aprueba/rechaza; solo él
    // puede cambiar el estado (para poder mandar el enlace del grupo
    // de trabajo de WhatsApp solo a quien se apruebe).
    // ───────────────────────────────────────────────────────
    match /voluntarios_dev/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow update, delete: if isAdmin();
    }

    match /user_titles/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // CONVOCATORIAS DE COLABORACIÓN (proyectos activos que el
    // admin publica para que la comunidad se sume por WhatsApp)
    // ───────────────────────────────────────────────────────
    match /convocatorias/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // NOTICIAS Y CONFIGURACIÓN DEL SITIO (público)
    // ───────────────────────────────────────────────────────
    match /noticias/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Vitrina pública de proyectos/apps creadas por la comunidad
    // (distinto de la colección "proyectos", que son los logros
    // asignados a cada miembro en su ficha).
    match /proyectos_publicos/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // TENDENCIAS DE PREGUNTAS (público, anónimo, agregado)
    // Alimenta el bloque de la portada "lo que más pregunta la
    // comunidad". Solo se guardan CONTEOS por tema y país, nunca
    // texto de preguntas ni datos personales — por eso se permite
    // escribir sin sesión (el widget de IA vive también en la
    // portada, antes de loguearse). Se limita qué campos se puede
    // tocar y el formato del id del documento para reducir el
    // margen de abuso desde la consola del navegador.
    // ───────────────────────────────────────────────────────
    match /tema_stats/{docId} {
      allow read: if true;
      allow create, update: if
        docId.matches('^(global|pais_[A-Z]{2})$') &&
        request.resource.data.diff(resource == null ? {} : resource.data)
          .affectedKeys().hasOnly(['conteos', 'total', 'actualizado', 'nombre']);
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // CHAT
    // ───────────────────────────────────────────────────────
    match /chat_rooms/{roomId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.type != 'dm' || request.auth.uid in resource.data.participants);

      allow create: if isSignedIn() && (
        request.resource.data.type != 'dm' ||
        (request.auth.uid in request.resource.data.participants &&
         request.resource.data.participants.size() == 2)
      );

      // Antes cualquier usuario firmado (en salas grupales) podía
      // reescribir CUALQUIER campo de la sala, incluyendo "type" y
      // "participants" — eso permitía, por ejemplo, colarse en una
      // sala DM ajena editando su lista de participantes. La app
      // solo actualiza lastMsg/lastAt/msgCount al enviar un mensaje,
      // así que se limita la escritura a esos campos (el admin
      // conserva permiso total por separado).
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.type != 'dm' || request.auth.uid in resource.data.participants) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMsg', 'lastAt', 'msgCount'])
      );

      allow delete: if isAdmin();
    }

    match /chat_messages/{msgId} {
      allow read: if isSignedIn() && canAccessRoom(resource.data.roomId);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && canAccessRoom(request.resource.data.roomId);
      // Antes cualquier usuario con acceso a la sala podía reescribir
      // CUALQUIER campo del mensaje de otra persona (texto, uid, etc).
      // Lo único que la app realmente actualiza sobre un mensaje ajeno
      // es "threadCount" al responder en el hilo, así que se limita
      // la escritura a ese campo (el dueño del mensaje o el admin
      // conservan permiso total por separado).
      allow update: if isAdmin() || isOwner(resource.data.uid) || (
        isSignedIn() && canAccessRoom(resource.data.roomId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['threadCount'])
      );
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /chat_replies/{replyId} {
      allow read: if isSignedIn() && canAccessRoom(resource.data.roomId);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && canAccessRoom(request.resource.data.roomId);
      allow update: if false;
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ───────────────────────────────────────────────────────
    // PRESENCIA POR SALA
    // ───────────────────────────────────────────────────────
    match /room_presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && presenceId == request.resource.data.roomId + '_' + request.auth.uid;
      allow delete: if isSignedIn() &&
        (presenceId == resource.data.roomId + '_' + request.auth.uid || isAdmin());
    }
  }
}
